# Copy to .env and fill in.
GEMINI_API_KEY=your_gemini_api_key_here
HF_API_KEY=your_huggingface_token_here

# gemini | mock      (mock = no API key needed, canned story)
LLM_BACKEND=gemini
# diffusers | hf_api | gemini | pollinations | mock
#   gemini       = uses GEMINI_API_KEY (image models may need billing enabled)
#   pollinations = free, no key, rate-limited
#   mock         = placeholder images
IMAGE_BACKEND=pollinations
GEMINI_IMAGE_MODEL=gemini-2.5-flash-image
POLLINATIONS_MODEL=flux

# Model names: check https://ai.google.dev/gemini-api/docs/models
OUTLINE_MODEL=gemini-2.5-flash
STORY_MODEL=gemini-2.5-pro
SD_MODEL_ID=stable-diffusion-v1-5/stable-diffusion-v1-5
HF_IMAGE_MODEL=stabilityai/stable-diffusion-xl-base-1.0

NUM_INFERENCE_STEPS=25
PANEL_COUNT=5
PRELOAD_IMAGE_MODEL=false
DEBUG=false
# Optional TTF for full Unicode text in PDFs, e.g. app/static/fonts/DejaVuSans.ttf
# PDF_FONT_PATH=
